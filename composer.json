{
    "name": "rizerapps/laravel-plugnotas",
    "description": "Cliente PlugNotas/TecnoSpeed (NF-e) para Laravel — transporte e formato, sem regra fiscal.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rizer\\PlugNotas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rizer\\PlugNotas\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
