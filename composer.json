{
    "name": "rizerapps/laravel-plugnotas",
    "description": "Cliente PlugNotas/TecnoSpeed (NF-e e NFS-e) para Laravel — transporte e formato, sem regra fiscal.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.2|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rizer\\PlugNotas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rizer\\PlugNotas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rizer\\PlugNotas\\PlugNotasServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
